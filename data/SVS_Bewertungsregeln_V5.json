  "average_rule": {
    "method": "arithmetic_mean_floor",
    "formula": "local_assessed_level = floor(sum(required_individual_ratings) / count(required_individual_ratings))",
    "equal_weights": true,
    "rounding": "floor",
    "round_only_after_division": true,
    "scope": [
      "individual_practice",
      "optional_individual_detail_index"
    ],
    "averaging_unit": "Ein fachlich abgegrenzter Einzelaspekt mit einer belegten Note 1–5, genau einmal gewichtet. Keine Mittelung fester Stufennummern von Prüffragen oder Ja/Nein-Codes.",
    "allow_compensation_between_criteria": true,
    "raw_mean_field": "unrounded_mean",
    "criterion_results_visible": true,
    "practice_baseline_excluded_from_average": "C00 ist ein Basisnachweis und kein gleichgewichteter Kriterienblock mit dauerhaftem Maximalwert 1.",
    "unknown_policy": "Fehlende, ungeprüfte oder nicht numerisch einordenbare notwendige Kriterien nicht als 0 einsetzen und nicht aus dem Nenner streichen. Vollständigen Durchschnitt offenlassen; vorhandene Detailstände anzeigen.",
    "upper_bound": "floor(sum(possible_upper_levels) / count(required_criteria)); ungeklärte höhere Stufen bleiben bis 5 möglich.",
    "status": "confirmed, wenn abgerundete Unter- und Obergrenze übereinstimmen; sonst provisional bei belegtem numerischem Mindestindex.",
    "example": {
      "criterion_levels": [
        2,
        3,
        4
      ],
      "unrounded_mean": 3.0,
      "assessed_level": 3
    },
    "fractional_example": {
