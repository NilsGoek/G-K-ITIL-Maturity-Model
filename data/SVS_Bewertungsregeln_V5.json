{
  "policy_id": "GOEK-SVS-LOCAL-MEAN-COMPONENT-GATES-SVS-MIN-V5",
  "policy_version": "5.0.0",
  "language": "de-DE",
  "official_peoplecert_rule": false,
  "basis": "Korrigierter Nutzerauftrag vom 2026-10-13: eigene Einzelstufen und abgerundete Mittelwerte für Einzelbewertungen; ausdrückliche Level-Voraussetzungen für fünf Kategorien; Minimum ausschließlich für das ganze SVS.",
  "requirement_states": [
    "fulfilled",
    "not_fulfilled",
    "open"
  ],
  "canonical_fields": {
    "answer": [
      "yes",
      "partial",
      "no",
      "unknown"
    ],
    "finding": [
      "fulfilled",
      "not_fulfilled",
      "partial",
      "open",
      "not_applicable"
    ],
    "review_status": [
      "pending",
      "approved"
    ],
    "evidence_status": [
      "not_checked",
      "sufficient",
      "insufficient",
      "conflicting"
    ]
  },
  "question_rule": {
    "fulfilled": "Alle zutreffenden Prüfpunkte erfüllt; finding=fulfilled, review_status=approved, evidence_status=sufficient; passende registrierte Nachweise, Begründung und Prüfer vorhanden.",
    "not_fulfilled": "Mindestens ein zutreffender Pflichtprüfpunkt nachweislich nicht erfüllt oder nur teilweise erfüllt; fachlich freigegeben und ausreichend belegt.",
    "open": "Fehlende Antwort, fehlender oder ungeprüfter Befund, unzureichende/widersprüchliche Nachweise oder noch ungeklärte Anwendbarkeit ohne belegte Nichterfüllung.",
    "self_report_is_not_score": true,
    "partial_is_not_fulfilled": true,
    "no_points_or_percentages": true,
    "conditional_checks": "not_applicable nur bei bezeichnetem bedingtem Prüfpunkt und bestätigter, belegter Anwendbarkeitsentscheidung. Ganze Fragen bleiben Pflicht, soweit der Katalog keine Ausnahme erlaubt."
  },
  "level_rule": {
    "method": "highest_fully_eligible_component_level",
    "scope": "five_svs_components",
    "all_required_conditions_must_be_fulfilled": true,
    "higher_features_compensate_lower_gaps": false,
    "positive_requirements_cumulative": true,
    "initial_deficit_descriptions_are_not_higher_level_prerequisites": true,
    "unconfirmed_is_not_fulfilled": true,
    "missing_evidence_is_not_level_1": true,
    "individual_ladders": "Eigene fachlich passende Stufen je Einzelaspekt; kumulative Prüfung ausschließlich innerhalb dieses Aspekts."
  },
  "minimum_rule": {
    "method": "minimum",
    "scope": [
      "whole_svs"
    ],
    "formula": "svs.assessed_level = min(five_component_assessed_levels)",
    "requires_all_five_categories": true,
    "missing_is_zero": false,
    "arithmetic_mean": false,
    "improvement_focus": "Die schwächste Kategorie bestimmt die Gesamtbewertung. Alle höheren Kategorien und Einzelstärken bleiben sichtbar."
  },
  "practices_component_rule": {
    "method": "explicit_role_thresholds",
    "enabled": true,
    "required_roles": [
      "primary",
      "supporting"
    ],
    "key_role_value": "primary",
    "at_least_one_key_practice_required": true,
    "thresholds": [
      {
        "level": 1,
        "all_key_practices_min_capability": 1,
        "all_supporting_practices_min_capability": null
      },
      {
        "level": 2,
        "all_key_practices_min_capability": 2,
        "all_supporting_practices_min_capability": null
      },
      {
        "level": 3,
        "all_key_practices_min_capability": 3,
        "all_supporting_practices_min_capability": 1
      },
      {
        "level": 4,
        "all_key_practices_min_capability": 4,
        "all_supporting_practices_min_capability": 2
      },
      {
        "level": 5,
        "all_key_practices_min_capability": 5,
        "all_supporting_practices_min_capability": 3
      }
    ],
    "rule": "Höchstes Level, dessen getrennte Schwellen alle Schlüssel- und alle erforderlichen unterstützenden Practices im geprüften Umfang erfüllen. Keine Mittelung und kein Minimum aller Practice-Noten.",
    "supporting_scope": "Alle unterstützenden Practices des bewerteten Funktionsbereichs bzw. Umfangs erfassen und fachlich prüfen; Auswahl darf keine notwendigen Practices weglassen.",
    "no_supporting_practices": "Leere unterstützende Menge nur nach dokumentierter Prüfung zulässig; dann ist die zugehörige Allaussage erfüllt.",
    "no_supporting_threshold_at_levels_1_2": true
  },
  "svs_aggregation": {
    "enabled": true,
    "method": "minimum",
    "required_component_ids": [
      "governance",
      "service_value_chain",
      "guiding_principles",
      "continual_improvement",
      "practices"
    ],
    "rule": "Optionaler Gesamtwert = Minimum der fünf vollständigen Komponentenwerte für dieselbe Bewertungseinheit, denselben geprüften Umfang und Zeitraum. Teilprofile, fehlende Komponenten und ungeklärte Widersprüche verhindern eine vollständige Gesamtnote.",
    "single_overall_score_is_optional": true
  },
  "draft_rule": {
    "result_is_draft_formula": "Eigener Katalog/Modul fachlich nicht validiert ODER Modus draft_preview/pilot ODER irgendein erforderliches Quellergebnis ist Entwurf.",
    "model_validation_completed_formula": "Nur true, wenn der eigene verwendete Bewertungsmaßstab und alle erforderlichen Quellmodelle nachweislich validiert sind.",
    "is_final_formula": "Numerischer Stand oder Unter-Stufe-1-Befund abschließend geklärt, vollständiger geprüfter Kontext, alle erforderlichen Scope-Prüfungen und Freigaben vorhanden und result_is_draft=false.",
    "automatic_promotion_from_draft": false,
    "regular_mode": "Nicht validierte Kataloge oder Module sind im regular-Modus gesperrt; im draft_preview-Modus berechenbar und durchgehend als Entwurf gekennzeichnet.",
    "ci_dependency": "PR02-Entwurfskennzeichnung und Validierungsstatus unverändert in CI und jeden darüber aggregierten Wert übernehmen."
  },
